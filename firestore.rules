rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNGSI PEMBANTU (HELPERS) ---
    
    // Cek apakah user sudah login
    function isAuthenticated() {
      return request.auth != null;
    }

    // Cek apakah user adalah Super Admin (Akses Mutlak)
    function isSuperAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // --- AKSES TOTAL UNTUK SUPER ADMIN ---
    // Jika role Anda 'super_admin', Anda bisa baca/tulis/hapus APAPUN di Firestore.
    // Ini menjamin Website Admin tidak akan pernah kena "Permission Denied".
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // --- ATURAN UNTUK USER BIASA (Aplikasi Mobile) ---

    // 1. Barbershop, Service, Barbermen: Bisa dibaca siapa saja (Katalog Publik)
    match /barbershops/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /services/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /barbermen/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 2. Data Transaksi (Queue, User, Tenant, Notification)
    // Untuk user biasa, wajib login untuk baca/tulis datanya sendiri.
    // (Super Admin sudah di-cover oleh rule paling atas).
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    match /queues/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /tenants/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /notifications/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // 3. Rating & Ulasan
    match /app_ratings/{ratingId} {
      // User login boleh mengirim rating
      allow create: if isAuthenticated();
      // Hanya pemilik rating yang boleh baca/edit (opsional, atau public read jika ingin ditampilkan di app)
      allow read: if true; 
    }
  }
}
