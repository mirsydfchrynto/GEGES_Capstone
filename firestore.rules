rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNGSI PEMBANTU (HELPERS) ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- AKSES TOTAL UNTUK SUPER ADMIN ---
    // Aturan ini menimpa aturan di bawahnya untuk Super Admin.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // --- ATURAN UNTUK USER BIASA (Aplikasi Mobile) ---

    // 1. KATALOG PUBLIK (READ-ONLY untuk User Biasa)
    // Celah diperbaiki: User biasa TIDAK BOLEH menulis di sini.
    match /barbershops/{document=**} {
      allow read: if true;
      allow write: if false; // Hanya Super Admin (rule atas)
    }
    match /services/{document=**} {
      allow read: if true;
      allow write: if false; // Hanya Super Admin (rule atas)
    }
    match /barbermen/{document=**} {
      allow read: if true;
      allow write: if false; // Hanya Super Admin (rule atas)
    }
    match /promo_banners/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // 2. DATA USER
    match /users/{userId} {
      allow read: if isOwner(userId);
      // Create/Update: Boleh, TAPI tidak boleh mengubah field 'role' menjadi 'super_admin'
      allow write: if isOwner(userId) && 
        (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == resource.data.role || request.resource.data.role == 'user');
    }

    // 3. TRANSAKSI & ANTRIAN
    // Queue: User boleh membuat antrian (create) dan update status mereka sendiri.
    match /queues/{document=**} {
      allow read: if isAuthenticated(); // Perlu baca antrian orang lain untuk estimasi waktu
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.customerId == request.auth.uid);
      // Delete tidak diizinkan user biasa, gunakan update status 'canceled'
    }

    // Tenant: Pendaftaran mitra
    match /tenants/{document=**} {
      allow read, write: if isAuthenticated(); // Tenant owner perlu akses dokumennya
    }

    // Notifikasi
    match /notifications/{document=**} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated(); // Diperlukan trigger notifikasi client-side (jika ada)
    }
    
    // 4. RATING & ULASAN
    match /app_ratings/{ratingId} {
      allow read: if true; // Public boleh baca review
      allow create: if isAuthenticated(); // Hanya user login boleh review
      allow update, delete: if false; // Review permanen, tidak bisa diedit user (untuk integritas)
    }
  }
}