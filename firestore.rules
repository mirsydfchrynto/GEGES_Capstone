rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tenants collection: store tenant onboarding applications
    match /tenants/{tenantId} {

      // Authenticated users can create a tenant application
      allow create: if request.auth != null;

      // Tenant owner can read and update their own tenant doc while status != 'active'
      allow read: if isOwnerOrAdmin();
      allow update: if (isOwner() && resource.data.status != 'active') || isAdmin();

      // Only admins can set status to active or rejected
      function isAdmin() {
        return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      function isOwner() {
        return request.auth != null && request.auth.uid == resource.data.owner_uid;
      }

      function isOwnerOrAdmin() {
        return isAdmin() || (request.auth != null && request.auth.uid == resource.data.owner_uid);
      }
    }

    // Users collection: simple read for profile info restricted to owner or admin
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
