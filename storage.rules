rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // --- HELPER FUNCTIONS ---
    function isSuperAdmin() {
      // Mengakses Firestore dari Storage Rules untuk cek role user
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(tenantId) {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.owner_uid == request.auth.uid;
    }

    // --- GLOBAL BYPASS FOR SUPER ADMIN ---
    // Super Admin bisa baca/tulis SEMUA file di storage
    match /{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }

    // --- ATURAN SPESIFIK LAINNYA (Tetap dipertahankan) ---

    // Tenant documents
    match /tenants/{tenantId}/docs/{allPaths=**} {
      allow list: if isOwner(tenantId) || isAdmin();
      allow read: if isOwner(tenantId) || isAdmin();
      
      // Validasi upload untuk user biasa
      allow write: if (isOwner(tenantId) || isAdmin()) && 
        (request.resource.size < 5 * 1024 * 1024);
    }
    
    // Public/User uploads
    match /{allPaths=**} {
       allow read, write: if request.auth != null;
    }
  }
}